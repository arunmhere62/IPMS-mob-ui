API_BASE_URL=http://192.168.1.6:3000/api/v1

# Local API base URL — change this single value when your local IP/port changes.
# Used by app.config.js (build time) and environment.ts (runtime env switching).
LOCAL_API_BASE_URL=http://192.168.1.6:3001/api/v1

# iOS payment method: set to 'true' to use Apple In-App Purchase (default).
# Set to 'false' to route iOS paid plan payments through CCAvenue (like Android).
USE_IAP_FOR_IOS=false


# AWS S3 Configuration (Optional - for S3 uploads)
# If not configured, the app will fallback to direct backend uploads
AWS_S3_BUCKET_NAME=indianpgmanagement
AWS_REGION=ap-south-1
