{
  "name": "pg-mobile-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "postinstall": "node scripts/patch-webview-upi.js",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "prestart": "npm run typecheck",
    "android": "expo run:android",
    "preandroid": "npm run typecheck",
    "ios": "expo run:ios",
    "preios": "npm run typecheck",
    "web": "expo start --web",
    "lint": "tsc --noEmit && eslint . --ext .ts,.tsx",
    "clean": "powershell -Command \"Remove-Item -Recurse -Force @('android/app/.cxx', 'android/app/build', 'android/build', 'node_modules/.cache') -ErrorAction SilentlyContinue; Write-Host '✅ Build artifacts cleaned!' -ForegroundColor Green\"",
    "clean:deep": "powershell -Command \"Remove-Item -Recurse -Force @('android/app/.cxx', 'android/app/build', 'android/build', 'android/.gradle', 'node_modules/.cache', '.expo') -ErrorAction SilentlyContinue; Write-Host '✅ Deep clean completed!' -ForegroundColor Green\"",
    "clean:all": "powershell -Command \"Remove-Item -Recurse -Force @('android/app/.cxx', 'android/app/build', 'android/build', 'android/.gradle', 'node_modules', 'node_modules/.cache', '.expo') -ErrorAction SilentlyContinue; Write-Host '✅ Full clean completed! Run npm install' -ForegroundColor Yellow\"",
    "build:clean": "npm run clean && cd android && .\\gradlew assembleRelease",
    "build:local": "eas build -p android --profile local",
    "build:dev": "eas build -p android --profile development",
    "build:apk": "eas build -p android --profile apk",
    "build:aab": "eas build -p android --profile production",
    "build:standalone": "eas build -p android --profile standalone-apk",
    "build:minimal": "eas build -p android --profile minimal-apk"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@reduxjs/toolkit": "^2.0.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "dotenv": "^17.4.2",
    "expo": "^57.0.0",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-iap": "^5.3.1",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-print": "~57.0.1",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "lottie-react-native": "~7.3.8",
    "nativewind": "^2.0.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.0.4",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native-community/cli": "^19.0.0",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.1.10",
    "@types/react-native": "^0.72.8",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "3.3.2",
    "typescript": "^5.1.3"
  },
  "private": true
}
